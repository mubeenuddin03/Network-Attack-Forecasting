# Data files - ignore large originals, allow demo sample
data/raw/*
!data/raw/demo_sample.csv
data/processed/
*.pcap_ISCX.csv

# Models - ignore generated models, but ALLOW the trained baseline and world_model
models/*
!models/baseline/
!models/baseline/*
!models/world_model/
!models/world_model/*

# Python cache
__pycache__/
*.pyc

# Secrets
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Large generated data files
*.parquet
*.joblib
!models/baseline/*.joblib
!models/world_model/*.joblib
build_output*.txt
typescript_errors*.txt

.DS_Store

# ---------- Frontend ----------
# Dependencies
frontend/node_modules/

# Build output - allow frontend/dist so single-service deployment has static bundle
!frontend/dist/
!frontend/dist/**
frontend/dist-ssr/

# Local env files / secrets
frontend/.env
frontend/.env.*
!.env.example

# Logs & local diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/build_output.txt
frontend/build_output2.txt
frontend/typescript_errors*.txt
frontend/tsconfig.tsbuildinfo

# Caches
frontend/.vite/
frontend/coverage/
frontend/.eslintcache

# Local team distribution only - never push
members_tasks/

# Stray test / scratch CSVs
syn_ratio_extreme_attack.csv
*.scratch.csv