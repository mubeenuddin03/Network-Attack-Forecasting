# Data files - ignore large originals, allow demo sample
data/raw/*
!data/raw/demo_sample.csv
data/processed/
*.pcap_ISCX.csv

# Models - ignore generated models, but ALLOW the trained baseline (small, required for deployment)
models/*
!models/baseline/
!models/baseline/*

# Python cache
__pycache__/
*.pyc

# Secrets
.env

# Jupyter
.ipynb_checkpoints/

# Large generated data files (but NOT models/baseline/)
*.parquet
*.joblib
!models/baseline/*.joblib

.DS_Store

# ---------- Frontend ----------
# Dependencies
frontend/node_modules/

# Build output
frontend/dist/
frontend/dist-ssr/

# Local env files / secrets
frontend/.env
frontend/.env.*
!.env.example

# Logs & local diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/build_output.txt
frontend/build_output2.txt
frontend/typescript_errors*.txt
frontend/tsconfig.tsbuildinfo

# Caches
frontend/.vite/
frontend/coverage/
frontend/.eslintcache